# BharatCode / Adaption model API key (create at adaptionlabs.ai -> Settings -> API keys)
ADAPTION_API_KEY=pt_live_...

# Database: leave empty for local SQLite; on Render use a Postgres URL (e.g. Neon free tier)
DATABASE_URL=

# Public address of this app (used in poster links and WhatsApp image links)
PUBLIC_BASE_URL=https://straywatch.onrender.com

# WhatsApp Cloud API (developers.facebook.com -> your app -> WhatsApp -> API Setup)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=straywatch-verify
WHATSAPP_APP_SECRET=
WHATSAPP_DISPLAY_NUMBER=   # e.g. 919800000000, for wa.me links on the website

# Demo data (sample helpers and animals in Ranchi) so the website demo works: 1 = on
SW_DEMO_MODE=1

# Optional: approved WhatsApp template for rescue alerts to helpers who have not chatted in 24 h
WHATSAPP_ALERT_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en
